<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- This file demonstrates the use of some <gazebo> tags -->
    <!-- Ported from Gazebo Classic to the new Gazebo (Harmonic, used with ROS 2 Jazzy), following video #10. -->

    <!-- To include it add the following line -->
    <!-- <xacro:include filename="example_gazebo.xacro" /> -->



    <!-- Colours: the new Gazebo reads the <material><color> already in the URDF, so the old
            <material>Gazebo/Green</material> tags are no longer needed (and no longer work). -->




    <!-- Plugins in the new Gazebo don't talk to ROS directly. They publish/subscribe to Gazebo topics,
            and ros_gz_bridge (see config/gz_bridge.yaml) copies those across to ROS topics. -->


    <!-- This plugin will publish the joint states for the selected joints
            (which robot_state_publisher can then use to broadcast the approprate tf). -->
    <!-- Gazebo topic: joint_states  ->  bridged to ROS topic /joint_states -->

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>slider_joint</joint_name>
            <joint_name>arm_joint</joint_name>
        </plugin>
    </gazebo>


    <!-- This plugin will read a JointTrajectory message and move the joints there using PID position control.
            It replaces the Classic gazebo_ros_joint_pose_trajectory plugin. -->
    <!-- Gazebo topic: set_joint_trajectory  <-  bridged from ROS topic /set_joint_trajectory -->
    <!-- Here's an example message to publish to test it:
            ros2 topic pub -1 /set_joint_trajectory trajectory_msgs/msg/JointTrajectory  '{joint_names: [slider_joint, arm_joint], points: [  {positions: [0.8,0.6]} ]}' -->
    <gazebo>
        <plugin filename="gz-sim-joint-trajectory-controller-system"
            name="gz::sim::systems::JointTrajectoryController">
            <topic>set_joint_trajectory</topic>
            <joint_name>slider_joint</joint_name>
            <initial_position>0.0</initial_position>
            <position_p_gain>200</position_p_gain>
            <position_i_gain>20</position_i_gain>
            <position_d_gain>20</position_d_gain>
            <position_i_min>-100</position_i_min>
            <position_i_max>100</position_i_max>
            <position_cmd_min>-100</position_cmd_min>
            <position_cmd_max>100</position_cmd_max>
            <joint_name>arm_joint</joint_name>
            <initial_position>0.0</initial_position>
            <position_p_gain>300</position_p_gain>
            <position_i_gain>50</position_i_gain>
            <position_d_gain>20</position_d_gain>
            <position_i_min>-100</position_i_min>
            <position_i_max>100</position_i_max>
            <position_cmd_min>-100</position_cmd_min>
            <position_cmd_max>100</position_cmd_max>
        </plugin>
    </gazebo>







    <!-- The next section shows an example of adding a sensor, in this case a depth (RGB-D) camera. -->

    <!-- Due to a quirk of how cameras work, an extra joint/link is required to create an
            "optical frame" for the sensor. That isn't the focus for this tutorial, but you can
            look at https://www.ros.org/reps/rep-0103.html#suffix-frames for slightly more information. -->



    <!-- First, create the link and joint for the optical frame -->

    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.571 0 -1.571" />
        <parent link="camera_link" />
        <child link="camera_link_optical" />
    </joint>

    <link name="camera_link_optical"></link>


    <!-- Add a gazebo tag for the ORIGINAL camera_link, and set gz_frame_id to the optical frame so that ROS can orient things correctly. -->
    <!-- "rgbd_camera" gives us a colour image, a depth image and a point cloud, all from one sensor.
            For a plain colour camera, change the type to "camera". -->
    <!-- Sensors only work if the world loads the Sensors system plugin (see worlds/empty.sdf). -->
    <!-- Gazebo topics: camera/image, camera/depth_image, camera/points, camera/camera_info -->
    <gazebo reference="camera_link">
        <sensor type="rgbd_camera" name="my_camera">
            <topic>camera</topic>
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <update_rate>20</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <camera name="cam">
                <camera_info_topic>camera/camera_info</camera_info_topic>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>300</far>
                </clip>
                <depth_camera>
                    <clip>
                        <near>0.1</near>
                        <far>100</far>
                    </clip>
                </depth_camera>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>




</robot>
